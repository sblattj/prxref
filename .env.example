# ==============================================================================
# prxref environment configuration example
# Copy this file to .env and configure for your local environment or deployment.
#
# Commented-out lines show the built-in default. An empty or whitespace-only
# value reads as unset, so `PRXREF_LLM_TIMEOUT=` keeps the default rather than
# aborting. A malformed or out-of-range value is a configuration error:
# `prxref review` exits 2 and names the variable. See docs/env-vars.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM / Pipeline Configuration
# ------------------------------------------------------------------------------

# LLM backend: openai-compat (aliases: ferry, http) | litellm
PRXREF_LLM_BACKEND=openai-compat

# Base URL for any OpenAI-compatible /chat/completions endpoint. REQUIRED.
PRXREF_LLM_BASE_URL=https://openrouter.ai/api/v1

# API key for that endpoint. Leave empty for a local no-auth server.
PRXREF_LLM_API_KEY=

# Comma-separated fallback chain, cheapest first. REQUIRED.
PRXREF_LLM_MODELS=z-ai/glm-5.3-flash

# Reasoning effort for models that cannot disable reasoning (e.g. low|high|max
# for GLM-5.3-Flash). Empty = omit the parameter entirely. Provider-specific
# vocabulary; not validated client-side.
#
# On a reasoning model the hidden reasoning trace is billed against the SAME
# generation budget as the answer, so raising this makes truncation MORE likely.
# Raise PRXREF_LLM_MAX_TOKENS with it.
PRXREF_LLM_REASONING_EFFORT=

# Completion-token budget for each worker review call. Must be > 0.
# Too low and the model runs out of budget mid-JSON: the chunk is counted as
# failed and the posted summary says "response truncated at max_tokens=N".
# PRXREF_LLM_MAX_TOKENS=4096

# Per-request LLM timeout in seconds. Must be > 0.
# PRXREF_LLM_TIMEOUT=45.0

# Sampling temperature. Empty = omitted from the request entirely, which is not
# the same as sending 0 — some endpoints reject `temperature` alongside
# reasoning parameters. Finite and >= 0; no upper bound, since the maximum is
# provider-specific.
# PRXREF_LLM_TEMPERATURE=

# Findings below this confidence floor are dropped (default 0.6).
# A probability: must be within [0.0, 1.0] inclusive.
PRXREF_CONFIDENCE_FLOOR=0.6

# Max error-severity findings reported per review (default 10). Excess errors
# are dropped lowest-confidence-first. Must be >= 0; 0 caps every error.
# (Legacy alias: PRXREF_MAX_ERRORS.)
PRXREF_MAX_ERROR_FINDINGS=10

# Max diff chunks reviewed per PR (default 8). Must be > 0.
PRXREF_MAX_CHUNKS=8

# Approximate token budget per diff chunk. Must be > 0. Lowering it splits a PR
# into more, smaller chunks — which costs more calls but hands each worker less
# to hold at once.
# PRXREF_CHUNK_TOKEN_BUDGET=25000

# Max files placed in one review chunk. Must be > 0. Chunks stay under the cap
# while any chunk has room; once PRXREF_MAX_CHUNKS is reached, overflow files
# join the smallest chunk past the cap rather than being dropped from review.
# PRXREF_CHUNK_MAX_FILES=5

# Context lines kept around each change when a chunk's diff is rendered for the
# worker prompt. Must be >= 0; 0 emits the changed lines only. prxref trims the
# forge's diff — it never adds context the diff did not carry.
# PRXREF_CHUNK_CONTEXT_LINES=3

# Parallel chunk-review workers. Must be > 0.
# PRXREF_MAX_WORKERS=4

# Max inline comments posted per review, applied after the quality gate. Must
# be > 0. Findings beyond the cap still appear in the summary.
# PRXREF_MAX_INLINE_COMMENTS=15

# Set to exactly 1 to review without writing anything to the forge — no
# summary, no inline comments (default off). Applies to the webhook daemon as
# well as the CLI; `--no-post` is the per-invocation equivalent.
# PRXREF_DRY_RUN=0

# Exit-code policy for `prxref review` (default never). The default keeps the
# advisory contract: the exit code never reflects findings. "error" exits 1
# when the completed review carries an active error-severity finding; "any"
# exits 1 on any active finding; under either, a review that fails to
# complete also exits 1. A value outside never|error|any is a configuration
# error (exit 2). The webhook daemon has no exit code and ignores this knob.
# PRXREF_FAIL_ON=never

# What gets posted to the forge: summary+inline (default), summary, or inline.
# Any other value is a configuration error and `prxref review` exits 2.
# A dry run (--no-post / PRXREF_DRY_RUN=1) posts nothing in any mode.
# PRXREF_POST_MODE=summary+inline

# Set to 0 — or anything other than exactly 1 — to omit the verdict stamp
# from the posted summary. The literal 1 keeps it (default on). The
# total-failure notice always names its status regardless.
# PRXREF_POST_VERDICT=1

# ------------------------------------------------------------------------------
# Per-Forge Authentication Tokens
# ------------------------------------------------------------------------------

# Bitbucket Cloud bearer token (workspace or repo access token with
# pullrequest:write).
# PRXREF_BITBUCKET_TOKEN=

# Bitbucket Cloud username (for Basic auth with app password fallback)
# PRXREF_BITBUCKET_USER=

# Bitbucket Cloud app password (for Basic auth fallback)
# PRXREF_BITBUCKET_APP_PASSWORD=

# Bitbucket Server / Data Center HTTP access token (Bearer).
# Falls back to PRXREF_BITBUCKET_TOKEN when unset.
# PRXREF_BITBUCKET_SERVER_TOKEN=

# Bitbucket Server / Data Center basic-auth pair, used only when no token is set.
# PRXREF_BITBUCKET_SERVER_USER=
# PRXREF_BITBUCKET_SERVER_PASSWORD=

# GitHub token (Personal Access Token or GitHub App installation token for github.com)
# PRXREF_GITHUB_TOKEN=

# GitHub Enterprise token (used when host is not github.com; falls back to PRXREF_GITHUB_TOKEN)
# PRXREF_GITHUB_ENTERPRISE_TOKEN=

# GitLab token (Personal, project, or group access token with API access)
# PRXREF_GITLAB_TOKEN=

# ------------------------------------------------------------------------------
# Webhooks Configuration
# ------------------------------------------------------------------------------

# HMAC secret for Bitbucket webhook payloads
# PRXREF_BITBUCKET_WEBHOOK_SECRET=

# HMAC secret for GitHub webhook payloads (X-Hub-Signature-256)
# PRXREF_GITHUB_WEBHOOK_SECRET=

# Secret token / HMAC secret for GitLab webhook payloads (X-Gitlab-Token)
# PRXREF_GITLAB_WEBHOOK_SECRET=

# Set to exactly 1 to accept unsigned webhooks (default off; insecure).
# Only the literal "1" works — true/yes/on are intentionally NOT accepted.
PRXREF_ALLOW_UNSIGNED=0
